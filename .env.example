# Database connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/anistream_db?schema=public"

# Redis connection (Obrigatório em produção: cache, rate limiting e health check)
REDIS_PASSWORD="gere-uma-senha-aleatoria-com-pelo-menos-16-caracteres"
REDIS_URL="redis://:gere-uma-senha-aleatoria-com-pelo-menos-16-caracteres@localhost:6379"

# Security & Secret Keys
PLAYBACK_TOKEN_SECRET="gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres"
SOURCE_ENCRYPTION_KEY="gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres"

# Setup Security (Obrigatório em produção; nunca use um valor padrão)
INITIAL_SETUP_KEY="gere-um-segredo-de-instalacao-com-pelo-menos-24-caracteres"

# Self-hosted Kenjitsu API
KENJITSU_BASE_URL="http://kenjitsu:3000"
KENJITSU_API_KEY="gere-um-segredo-compartilhado-com-o-servico-kenjitsu"
KENJITSU_REQUEST_TIMEOUT_MS="10000"
KENJITSU_CACHE_TTL_SECONDS="300"
CALENDAR_CACHE_TTL_SECONDS="1800"
# Token usado somente pelo cron privado para processar a fila de pré-cache.
CACHE_WARM_WORKER_TOKEN="gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres"

# Native Kenjitsu extension endpoints (used by the self-hosted API container)
ANIZONEURL="https://anizone.to"
ANIKOTOURL="https://anikototv.to"
ANIDBURL="https://anidb.app"
ANIBDURL="https://anibd.app"
ANIMEHEAVENURL="https://animeheaven.me"
KENJITSU_REDIS_PASSWORD="kenjitsu-local-password"
KENJITSU_REDIS_TLS="false"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Hosts HTTPS separados por vírgula permitidos para logos, capas e favicon configuráveis.
# Deixe vazio para aceitar somente assets internos, como /icon.svg.
NEXT_PUBLIC_ASSET_HOSTS=""
TRUSTED_PROXY_IP_HEADER="CF-Connecting-IP"

# Somente o app publica uma porta no Compose local. PostgreSQL, Redis e Kenjitsu
# permanecem acessíveis apenas na rede interna do Compose/Dokploy.
ANISTREAM_APP_PORT="3000"
