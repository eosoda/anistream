# Database connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/anistream_db?schema=public"

# Redis connection (Optional for stream caching & rate limiting)
REDIS_URL="redis://localhost:6379"

# Security & Secret Keys
ADMIN_SESSION_SECRET="super-secret-admin-key-min-32-chars-long"
PLAYBACK_TOKEN_SECRET="super-secret-playback-jwt-key-min-32-chars"
SOURCE_ENCRYPTION_KEY="32-bytes-encryption-key-for-aes-256-gcm!"

# Setup Security (Opcional: se omitido, uma chave randômica é gerada nos logs do Docker/container)
INITIAL_SETUP_KEY="sua-chave-secreta-de-instalacao-setup"

# Self-hosted Kenjitsu API
KENJITSU_BASE_URL="http://kenjitsu:3000"
KENJITSU_API_KEY=""
KENJITSU_REQUEST_TIMEOUT_MS="10000"
KENJITSU_CACHE_TTL_SECONDS="300"

# Native Kenjitsu extension endpoints (used by the self-hosted API container)
ANIZONEURL="https://anizone.to"
ANIKOTOURL="https://anikototv.to"
ANIDBURL="https://anidb.app"
ANIBDURL="https://anibd.app"
ANIMEHEAVENURL="https://animeheaven.me"
KENJITSU_REDIS_PASSWORD="kenjitsu-local-password"
KENJITSU_REDIS_TLS="false"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional host-port overrides for running the self-hosted Compose beside another stack
ANISTREAM_APP_PORT="3000"
ANISTREAM_POSTGRES_PORT="5432"
ANISTREAM_REDIS_PORT="6379"
KENJITSU_PORT="3001"
KENJITSU_REDIS_PORT="6380"
