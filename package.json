{
  "name": "anistream",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "deploy:migrate": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "generate-tokens": "node scripts/generate-tokens.js",
    "test": "npx vitest run",
    "test:kenjitsu": "node scripts/smoke-kenjitsu.mjs",
    "test:watch": "npx vitest",
    "test:coverage": "npx vitest run --coverage",
    "test:docker": "node scripts/verify-docker.js",
    "test:e2e": "playwright test",
    "audit:performance": "node scripts/lighthouse-performance.mjs",
    "audit:performance:observed": "node scripts/lighthouse-performance.mjs --observed",
    "pre-deploy": "npm run lint && npm run typecheck && npm run test && npm run test:docker && npm run build",
    "deploy:local": "node scripts/deploy-local.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit:dependencies": "npm audit --omit=dev",
    "clean": "next clean"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "@tailwindcss/oxide": true,
    "esbuild": true,
    "prisma": true,
    "protobufjs": true,
    "re2": true,
    "sharp": true,
    "unrs-resolver": true
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.0.3",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.3",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.3.0",
    "@tanstack/react-query": "^5.101.4",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "hls.js": "^1.5.17",
    "jose": "^6.0.1",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "postcss": "^8.5.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "8.57.1",
    "eslint-config-next": "^15.5.23",
    "lighthouse": "13.3.0",
    "prisma": "^6.3.0",
    "tailwindcss": "4.1.11",
    "typescript": "5.9.3",
    "vitest": "^3.0.0"
  }
}
