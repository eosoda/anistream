// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Anime {
  id                  String   @id @default(cuid())
  title               String
  normalizedTitle     String
  originalTitle       String?
  slug                String   @unique
  description         String?
  synopsis            String?
  posterUrl           String?
  backdropUrl         String?
  rating              Float?   @default(8.0)
  year                Int?
  releaseYear         Int?
  status              String?
  genres              String?
  openingStartSeconds Float?
  openingEndSeconds   Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  aliases                   AnimeAlias[]
  identifiers               AnimeIdentifier[]
  episodes                  Episode[]
  releaseScheduleRule       ReleaseScheduleRule?
  releaseScheduleExceptions ReleaseScheduleException[]

  @@index([normalizedTitle])
  @@index([slug])
}

model AnimeAlias {
  id              String @id @default(cuid())
  animeId         String
  value           String
  normalizedValue String

  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@index([normalizedValue])
  @@index([animeId])
}

model AnimeIdentifier {
  id       String @id @default(cuid())
  animeId  String
  provider String
  value    String

  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([provider, value])
  @@index([animeId, provider])
}

model Episode {
  id                  String    @id @default(cuid())
  animeId             String
  season              Int       @default(1)
  number              Float
  title               String?
  description         String?
  overview            String?
  thumbnailUrl        String?
  durationSeconds     Int?
  openingStartSeconds Float?
  openingEndSeconds   Float?
  airedAt             DateTime?
  publishedAt         DateTime?

  anime   Anime           @relation(fields: [animeId], references: [id], onDelete: Cascade)
  sources EpisodeSource[]
  reports EpisodeReport[]

  @@unique([animeId, season, number])
  @@index([animeId, season])
  @@index([publishedAt])
}

model EpisodeSource {
  id               String          @id @default(cuid())
  episodeId        String
  provider         String
  urlEncrypted     String
  type             String
  quality          String?
  width            Int?
  height           Int?
  bitrate          Int?
  audioLanguage    String          @default("ja")
  headersEncrypted String?
  requiresProxy    Boolean         @default(false)
  priority         Int             @default(0)
  enabled          Boolean         @default(true)
  expiresAt        DateTime?
  lastCheckedAt    DateTime?
  lastStatus       Int?
  lastLatencyMs    Int?
  failureCount     Int             @default(0)
  trafficBytes     BigInt          @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  subtitles        SubtitleTrack[]

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([episodeId, enabled])
  @@index([provider])
}

model SubtitleTrack {
  id           String @id @default(cuid())
  sourceId     String
  language     String
  label        String
  format       String
  urlEncrypted String

  source EpisodeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
}

model ProviderHealthLog {
  id        String   @id @default(cuid())
  provider  String
  status    String
  latencyMs Int
  error     String?
  checkedAt DateTime @default(now())

  @@index([provider, checkedAt])
}

model AdminUser {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String?
  passwordHash String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sessions     AdminSession[]
  auditLogs    AdminAuditLog[]

  @@map("admin_users")
}

model AdminSession {
  id        String     @id @default(cuid())
  token     String     @unique
  userId    String
  user      AdminUser? @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime   @default(now())

  @@index([token])
  @@index([userId])
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  action       String
  resourceType String
  resourceId   String?
  summary      String
  metadataJson String?
  createdAt    DateTime @default(now())

  actor AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([resourceType, resourceId])
  @@index([action, createdAt])
}

model SystemAnnouncement {
  id          String   @id @default(cuid())
  title       String
  content     String
  type        String   @default("INFO") // INFO, WARNING, SUCCESS
  active      Boolean  @default(true)
  targetGroup String?  @default("all")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EpisodeReport {
  id          String   @id @default(cuid())
  episodeId   String
  type        String // NO_AUDIO, BROKEN_LINK, DESYNC_SUBTITLE, OTHER
  description String?
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, RESOLVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([episodeId])
  @@index([status])
}

model ChangelogRelease {
  id         String   @id @default(cuid())
  version    String
  title      String
  content    String
  type       String   @default("FEATURE") // FEATURE, FIX, IMPROVEMENT
  releasedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model WebhookConfig {
  id        String   @id @default(cuid())
  platform  String // DISCORD, TELEGRAM
  name      String
  url       String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model ReleaseScheduleRule {
  id          String   @id @default(cuid())
  animeId     String   @unique
  mode        String   @default("ADD") // ADD, OVERRIDE, HIDE
  weekday     Int?
  timeMinutes Int?
  timezone    String   @default("Asia/Tokyo")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@index([weekday, enabled])
}

model ReleaseScheduleException {
  id          String   @id @default(cuid())
  animeId     String
  dateKey     String
  mode        String   @default("MOVE") // ADD, MOVE, HIDE
  weekday     Int?
  timeMinutes Int?
  timezone    String   @default("Asia/Tokyo")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([animeId, dateKey])
  @@index([dateKey, enabled])
}

model HomepageLayout {
  id               String             @id @default(cuid())
  key              String             @unique
  draftJson        Json
  publishedJson    Json
  draftVersion     Int                @default(1)
  publishedVersion Int                @default(1)
  draftUpdatedAt   DateTime           @updatedAt
  publishedAt      DateTime           @default(now())
  draftUpdatedBy   String?
  publishedBy      String?
  createdAt        DateTime           @default(now())
  snapshots        HomepageSnapshot[]

  @@index([publishedAt])
}

model HomepageSnapshot {
  id           String   @id @default(cuid())
  layoutKey    String
  version      Int
  kind         String   @default("PUBLISHED") // PUBLISHED ou DRAFT
  label        String
  documentJson Json
  createdAt    DateTime @default(now())
  createdBy    String?

  layout HomepageLayout @relation(fields: [layoutKey], references: [key], onDelete: Cascade)

  @@unique([layoutKey, version, kind])
  @@index([layoutKey, createdAt])
}

model MediaProvider {
  id               String    @id @default(cuid())
  name             String
  type             String    @default("M3U") // M3U, JSON, API
  url              String
  priority         Int       @default(100)
  enabled          Boolean   @default(true)
  autoIndex        Boolean   @default(true)
  headersEncrypted String?
  lastTestedAt     DateTime?
  lastStatus       Int?
  lastLatencyMs    Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([enabled])
  @@index([priority])
}

model AutoIndexerQueue {
  id              String   @id @default(cuid())
  providerId      String
  animeTitle      String
  detectedEpisode Float    @default(1)
  metadataJson    String?
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
}
