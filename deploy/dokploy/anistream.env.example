DATABASE_URL=postgresql://user:password@postgres:5432/anistream_db?schema=public
REDIS_URL=redis://:<url-encoded-redis-password>@redis:6379
KENJITSU_BASE_URL=http://kenjitsu:3000
KENJITSU_API_KEY=replace-with-shared-secret
INITIAL_SETUP_KEY=replace-with-one-time-setup-secret
PLAYBACK_TOKEN_SECRET=replace-with-random-32-plus-character-secret
SOURCE_ENCRYPTION_KEY=replace-with-random-32-plus-character-secret
NEXT_PUBLIC_APP_URL=https://anistream.giancarlojunior.com.br
TRUSTED_PROXY_IP_HEADER=CF-Connecting-IP
KENJITSU_REQUEST_TIMEOUT_MS=10000
KENJITSU_CACHE_TTL_SECONDS=300
